#ifndef _RWStepRepr_RWBasicRoundHoleOccurrence_HeaderFile
#define _RWStepRepr_RWBasicRoundHoleOccurrence_HeaderFile

#include <Standard.hxx>
#include <Standard_DefineAlloc.hxx>
#include <Standard_Handle.hxx>

class StepData_StepReaderData;
class Interface_Check;
class StepRepr_BasicRoundHoleOccurrence;
class StepData_StepWriter;
class Interface_EntityIterator;

//! Read & Write tool for BasicRoundHoleOccurrence
class RWStepRepr_RWBasicRoundHoleOccurrence
{
public:
  DEFINE_STANDARD_ALLOC

  Standard_HIDDEN RWStepRepr_RWBasicRoundHoleOccurrence();

  Standard_HIDDEN void ReadStep(const occ::handle<StepData_StepReaderData>&           data,
                                const int                                             num,
                                occ::handle<Interface_Check>&                         ach,
                                const occ::handle<StepRepr_BasicRoundHoleOccurrence>& ent) const;

  Standard_HIDDEN void WriteStep(StepData_StepWriter&                                  SW,
                                 const occ::handle<StepRepr_BasicRoundHoleOccurrence>& ent) const;

  Standard_HIDDEN void Share(const occ::handle<StepRepr_BasicRoundHoleOccurrence>& ent,
                             Interface_EntityIterator&                             iter) const;
};
#endif // _RWStepRepr_RWBasicRoundHoleOccurrence_HeaderFile
